{
  "expo": {
    "name": "Auto Wizard",
    "slug": "auto-wizard",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.getautowizard.app",
      "buildNumber": "5",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Auto Wizard uses your camera so you can take photos of vehicle issues for AI diagnosis.",
        "NSPhotoLibraryUsageDescription": "Auto Wizard uses selected photos from your library to help diagnose visible vehicle problems."
      }
    },
    "android": {
      "package": "com.getautowizard.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f1a"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "com.android.vending.BILLING",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Auto Wizard uses selected photos from your library to help diagnose visible vehicle problems.",
          "cameraPermission": "Auto Wizard uses your camera so you can take photos of vehicle issues for AI diagnosis."
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#0a0f1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "380d535d-052a-4cc7-81bf-0588c8759ac6"
      }
    },
    "owner": "cswofford"
  }
}